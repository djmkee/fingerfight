# Copy to .env and fill in what you need. Empty values fall back to the defaults in
# src/desk/settings.py. There is no wallet key here on purpose: the desk refuses to start
# if a wallet-secret variable is present in .env or the environment.

# Solana JSON-RPC, Helius-compatible (default: https://api.mainnet-beta.solana.com)
SOLANA_RPC_URL=

# Jupiter quote API base (default: https://lite-api.jup.ag/swap/v1) and optional API key
JUPITER_BASE_URL=
JUPITER_API_KEY=

# DexScreener public API base (default: https://api.dexscreener.com)
DEXSCREENER_BASE_URL=

# Optional OpenAI-compatible LLM. Leave empty to run the roles on coded rules only.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Storage and policy locations (defaults: data/desk.sqlite3, config/policy.yaml)
DESK_DB_PATH=
DESK_POLICY_PATH=
