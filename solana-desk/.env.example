# Copy to .env and fill in what you need. Empty values fall back to the defaults in
# src/desk/settings.py. There is no wallet key here on purpose: the desk refuses to start
# if a wallet-secret variable is present in .env or the environment. The trading wallet's
# key lives only in the file `python signer.py init` creates (see config/signer.yaml).

# Solana JSON-RPC, Helius-compatible (default: https://api.mainnet-beta.solana.com).
# For dry_run and live trading use your own endpoint (Helius, Triton, QuickNode...): the
# public one rate-limits hard and is not meant for sending transactions.
SOLANA_RPC_URL=

# Jupiter quote and swap API base (default: https://lite-api.jup.ag/swap/v1) and optional API key
JUPITER_BASE_URL=
JUPITER_API_KEY=

# DexScreener public API base (default: https://api.dexscreener.com)
DEXSCREENER_BASE_URL=

# OpenAI-compatible LLM. Needed when policy.yaml says `decider: ai`: without it the desk
# buys nothing (switch to `decider: rules` to pick trades by coded rules instead).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Storage and policy locations (defaults: data/desk.sqlite3, config/policy.yaml)
DESK_DB_PATH=
DESK_POLICY_PATH=
